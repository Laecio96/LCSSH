#!/bin/bash
clear
[[ -e /home/versao ]] && rm /home/versao
# A verificacao usa o proprio repositorio (antes era um dominio de terceiros)
wget -P /home "${LCSSH_REPO:-https://raw.githubusercontent.com/laecio96/LCSSH/master}/Install/versao" > /dev/null 2>&1
[[ -f "/home/versao" ]] && {
	vrs1=$(sed -n '1 p' /bin/versao| sed -e 's/[^0-9]//ig')
    vrs2=$(sed -n '1 p' /home/versao | sed -e 's/[^0-9]//ig')
	[[ "$vrs1" != "$vrs2" ]] && mv /home/versao /tmp/att
}
