inst_pct () {
# 'netstat' nao e pacote (vem do net-tools); 'python-pip' virou python3-pip
_pacotes=("bc" "screen" "nano" "unzip" "lsof" "net-tools" "dos2unix" "nload" "jq" "curl" "figlet" "python3" "python3-pip")
for _prog in ${_pacotes[@]}; do
    apt install $_prog -y
done
# speedtest-cli: pacote do SO quando existir, senao via pip3
# (pip3 puro falha nos SO atuais por causa do PEP 668, dai o --break-system-packages)
apt install speedtest-cli -y >/dev/null 2>&1 || {
    pip3 install speedtest-cli >/dev/null 2>&1 || pip3 install --break-system-packages speedtest-cli >/dev/null 2>&1
}
# garante o comando 'speedtest' usado pelos menus quando o SO so traz o speedtest-cli
if ! command -v speedtest >/dev/null 2>&1; then
    _stcli=$(command -v speedtest-cli)
    [[ -n "$_stcli" ]] && ln -sf "$_stcli" /usr/local/bin/speedtest
fi
}
fun_bar 'inst_pct'
